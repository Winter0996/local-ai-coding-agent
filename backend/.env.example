# Copy this file to .env and fill in real values. .env is already in
# .gitignore — never commit real secrets.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=

# SQLite file path for the auth DB
CODEFORGE_DB_PATH=codeforge.db

# Set to "true" once served over HTTPS (required for the refresh-token
# cookie's Secure flag to actually be honored by the browser). Keep "false"
# for local http://localhost dev.
COOKIE_SECURE=false

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Where ChromaDB persists its vector store on disk (per-workspace collections).
CHROMA_PERSIST_DIR=chroma_data

# Set to "1" only in tests — swaps the real sentence-transformers model for
# a fast, deterministic, network-free fake. Never set this in normal use.
# CODEFORGE_FAKE_EMBEDDINGS=1